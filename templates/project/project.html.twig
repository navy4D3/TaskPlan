{% extends 'base.html.twig' %}

{% block title %}Projet - TaskPlan{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    {{ encore_entry_link_tags('project-style') }}
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    {{ encore_entry_script_tags('project') }}
    <script src="https://cdn.jsdelivr.net/npm/sortablejs@latest/Sortable.min.js"></script>
    <script>
        
    </script>
{% endblock %}

{% block body %}
    <div  id="sections"class="sections" data-project-id={{ project.id}}>
        {# <div id="sections-list"> #}
            {% for section in sections %}
                <div data-section-id="{{section.id}}" class="section">
                    <div class="header" style="background-color: {{ section.color.hex}}">
                        <div class="left">
                            <twig:ux:icon name="{{ section.icon.icon }}"  style="color: {{ section.color.textColor}}"/>
                            <h2 style="color: {{ section.color.textColor}}">{{ section.title}}</h2>
                        </div>
                        
                        <twig:ux:icon class="show-delete-section-popup-btn trash-icon" name="tabler:trash" style="display:none"/>

                    </div>

                    <div class="tasks">
                        {# <span class="task">Ceci est une tache de test</span> #}
                        <div class="tasks-list">    
                            {% set sectionTasks = tasksBySection[section.id] %}
                            {% if sectionTasks|length > 0 %}
                                {% for task in sectionTasks %}
                                    <span class="task" data-task-id="{{task.id}}">{{ task.title }}</span>
                                {% endfor %}
                            {% else %}
                                <span class="empty-tasks-message text-center opacity-50 w-100" data-task-id="0">Aucune tâche pour cette section</span>
                            {% endif %}
                        </div>
                        
                        <button class=" tasks-btn show-add-task-popup-btn btn outline-dotted" data-section-id="{{ section.id }}">
                            <twig:ux:icon name="bi:plus-lg" />
                            Ajouter
                        </button>
                    </div>
                </div>
            {% endfor %}

            <div id="show-add-section-popup-btn" class="section add-section">
                <twig:ux:icon name="bi:plus-lg" />
                <h2>Ajouter une<br>section</h2>
            </div>
        {# </div> #}

        
    </div>

    <div id="add-task-popup" class="add-task-popup popup center" style="display:none">
        <div class="label-quit">
            <span>Ajouter une tâche</span>
            <twig:ux:icon class="close-popup-btn"name="bi:x" />
        </div>

        <input type="text" placeholder="Nom de la tâche">
        <button class="add-task-btn mallow-medium btn inactive">Ajouter</button>
    </div>

    <div class="task-popup popup center" style="display:none">
        <div class="header">
            <button class="end-task-btn btn mallow-medium">
                <twig:ux:icon name="bi:check-lg" />
                Terminer la tâche
            </button>

            <div class="close-delete-btns">
                <twig:ux:icon class="delete-task-btn trash-icon" name="tabler:trash" />
                <twig:ux:icon class="close-popup-btn" name="bi:x-lg" />
            </div>
        </div>

        <div class="labels">
            {# completer pour ajouter les labels rattaché à la tache #}
        </div>

        <div class="title-description">
            <h3 class="title">Titre</h3>

            <input class="description" type="text" placeholder="Description de la tâche">
        </div>

        <div class="checklist-section">
            <h4>Checklist</h4>

            <div class="checklist-list">
                <div class="checklist">
                    <div class="left">
                        <div class="radio-icon">
                            <div class="selected" style="display:none">
                            </div>
                        </div>
                        <span>Exemple de checklist</span>
                    </div>
                    
                </div>
                
                <div class="add-checklist-input" style="display:none">
                    <div class="left">
                        <div class="radio-icon">
                            <div class="selected" style="display:none">
                            </div>
                        </div>
                        <input type="text">
                    </div>
                </div>

                {# list des checklists #}
                <div class="add-checklist-btn ">
                    <twig:ux:icon name="bi:plus-lg" />
                    <button class="add-checklist-label">Ajouter</button>
                </div>
            </div>
            
            
            
        </div>

        
    </div>

    <div id="add-section-popup" class="add-section-popup popup center" style="display:none">
        <div class="header">
            <span>Ajouter une section</span>
            <twig:ux:icon class="close-popup-btn"name="bi:x-lg" />
        </div>

        <input name="title" type="text" placeholder="Titre de la section (15 caractères max)" maxlength="15">

        <div class="icon-section">
            <label for="icon">Choisissez une icône</label>
            <div class="icons">
                    {% for icon in icons %}
                        <twig:ux:icon id="{{ icon.label }}" class="icon" name="{{icon.icon}}" />
                    {% endfor %}
            </div>
            <input name="icon" type="hidden">
        </div>

        <div class="color-section">
            <label for="color">Choisissez une couleur</label>
            <div class="colors">
                {% for color in colors %}
                    <div class="color" id="{{ color.label }}" style="background-color: {{color.hex}}"></div>
                {% endfor %}  
            </div>
            <input name="color" type="hidden">
        </div>
        <button class="add-section-btn mallow-medium btn inactive">Ajouter</button>
    </div>

    <div id="delete-section-popup" class="delete-section-popup popup center" style="display:none">

        <h4>Souhaitez-vous réellement supprimer la section ?</h4>
        <p>La section et toute les taches qui y sont rattachés seront supprimés.</p>

        <div class="btns">
            <button class="btn mallow-medium delete-section-btn">Confirmer</button>
            <button class="btn underline hide-popup-btn">Annuler</button>
        </div>
    </div>

    <div class="blur-effect"></div>


{% endblock %}
