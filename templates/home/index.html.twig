{% extends 'base.html.twig' %}

{% block stylesheets %}
    {{ parent() }}
    {{ encore_entry_link_tags('home-style') }}
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    {{ encore_entry_script_tags('home') }}
{% endblock %}

{% block title %}Taskplan, gérez facilement{% endblock %}

{% block body %}
    {% if app.user %}
        <p>Utilisation {{ app.user.email}} connecté</p>
        <a href="/logout">Se deconnecter</a>
    {% endif %}
    <div class="top-section">
        <div class="task1">
            <span>Contacter l'IT</span>
            <twig:ux:icon name="bi:check-lg" />
        </div>

        <div class="task2">
            <span class="white-text">Décliner offre</span>
            <twig:ux:icon name="bi:x" />
        </div>

        <div class="task3">
            <span>Appeler maman</span>
            <twig:ux:icon name="lucide:loader" />
        </div>

        <img class="logo" src="./logo-taskplan-white.svg" alt="logotaskplan">

        <h1>Organisez vos tâches. Simplifiez vos journées</h1>

        <p>Taskplan est l'outil moderne qui vous aide à gérer vos projets, suivre vos objectifs et gagner du temps au quotidien.</p>
    </div>

    <div class="register-login-section">
        <div class="labels">
            <span id="register-label" class="selected">S'inscrire</span>
            <span id="login-label">Se connecter</span>
        </div>

        {% include 'registration/register.html.twig' %}

        {% include 'security/login.html.twig' %}

    </div>

    <div class="app-description-section">
        <h2>Finis les post-it éparpillés et les tâches oubliées</h2>
        <p>Avec TaskPlan, centralisez toutes vos tâches dans une interface claire et intuitive. Planifiez vos projets, suivez vos progrès et gardez toujours une vue d’ensemble.</p>
        <div class="tasks">
            <div class="tasks-todo">
                <twig:ux:icon name="bi:list-ul" />
                <div class="task">
                </div>
                <div class="task">
                </div>
                <div class="task">
                </div>
                <div class="task">
                </div>
            </div>
            <div class="tasks-current">
                <twig:ux:icon name="lucide:loader" />
                <div class="task">
                </div>
                <div class="task">
                </div>
                <div class="task">
                </div>
            </div>

            <div class="tasks-done">
                <twig:ux:icon name="bi:check-lg" />
                <div class="task">
                </div>
                <div class="task">
                </div>
            </div>
        </div>

        <button id="boost-productivity-btn">Booster ma productivité</button>
    </div>

    <div class="footer">
        <span class="taskplan">TaskPlan</span>
        <span class="since2025">Since 2025.</span>
    </div>
{% endblock %}
