{% extends 'base.html.twig' %}

{% block stylesheets %}
    {{ parent() }}
    {{ encore_entry_link_tags('profil-style') }}
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    {{ encore_entry_script_tags('profil') }}
{% endblock %}

{% block title %}Taskplan - Profil{% endblock %}

{% block body %}
    <div class="menu-and-details">
        <div class="menu">
            <div class="initials-name">
                <span class="initials">{{ app.user.prenom|slice(0,1) ~ app.user.nom|slice(0,1)|upper }}</span>
                <h1 class="complete-name">{{ app.user.prenom|capitalize }} {{ app.user.nom|capitalize }}</h1>
            </div>

            <ul class="btns">
                <li id="my-projects-btn" class="selected">
                    <twig:ux:icon name="material-symbols:folder-rounded" />
                    <span>Mes projets</span>
                </li>
                <li id="my-data-btn">
                    <twig:ux:icon name="material-symbols:info-outline-rounded" />
                    <span>Mes informations</span>
                </li>
                <li id="parameters-btn">
                    <twig:ux:icon name="lucide:settings" />
                    <span>Paramètres</span>
                </li>
            </ul>
        </div>

        <div class="section-details">
            <div class="my-projects-section section">
                <div class="label-btn">
                    <h2>Mes projets</h2>
                    <button class="show-add-project-popup-btn"><twig:ux:icon name="bi:plus-lg" />Ajouter</button>
                </div>

                <div class="projects" style="">
                    {% if app.user.projects is empty %}
                        <p style="opacity:75%" class="empty-projects-message">Aucun projet en cours</p>
                    {% else %}
                        {% for project in app.user.projects %}
                            <div class="project " data-project-id={{ project.id }}>
                                <a class="swipe-item"href="project/{{ project.id }}" >{{ project.title }}</a>
                                <twig:ux:icon class="show-delete-project-popup-btn trash-icon hidden-action" name="tabler:trash" style="opacity:0%"/> 
                            </div>
                        {% endfor %}
                    {% endif %}
                </div>
            </div>

            <div class="my-data-section section" style="display:none;">
                <div class="label-btn">
                    <h2>Mes informations</h2>
                    <button id="edit-data-btn" formaction="/profil/edit-data" type="action" style="display:none;"><twig:ux:icon name="mage:edit" />Modifier</button>
                </div>

                {{ form_start(myDataForm, { 'attr' : {'class' : 'base-form my-data-form' }}) }}
                    {# {{ form_row(registrationForm.nom) }} #}
                    {{ form_row(myDataForm.nom) }}
                    {{ form_row(myDataForm.prenom) }}

                    {# <button  class="btn submit inactive">S'inscrire</button> #}
                {{ form_end(myDataForm) }}
            </div>

            <div class="parameters-section section" style="display:none;">
                <h2>Paramètres</h2>
                
                <div class="parameters">
                    <ul class="">
                        <li id="show-edit-password-section-btn">Modifier mon mot de passe</li>
                        <li id="show-edit-mail-section-btn">Modifier mon adresse mail</li>
                        <a href="/cgu"><li>Conditions Générales d'Utilisation</li></a>
                        <a href="/mentions-legales"><li>Mentions légales</li></a>
                    </ul>

                    <ul class="negative">
                        <a href="/logout"><li class="full">Deconnexion</li></a>
                        <li class="show-delete-account-popup-btn" >Supprimer le compte</li>
                    </ul>
                </div>
            </div>

            <div class="edit-mail-section section" style="display:none;">
                <h3>Modification du mail</h3>

                {{ form_start(editMailForm, { 'attr' : {'class' : 'base-form edit-mail-form' }}) }}
                    {# {{ form_row(registrationForm.nom) }} #}
                    {{ form_row(editMailForm.email) }}
                    {{ form_row(editMailForm.password) }}

                    <button type="button" class="btn mallow-medium submit inactive">Modifier le mail</button>
                {{ form_end(editMailForm) }}
            </div>

            <div class="edit-password-section section" style="display:none;">
                <h3>Modification du mot de passe</h3>

                {{ form_start(editPasswordForm, { 'attr' : {'class' : 'base-form edit-password-form' }}) }}
                    {{ form_row(editPasswordForm.currentPassword) }}
                    {{ form_row(editPasswordForm.password.first) }}
                    {{ form_row(editPasswordForm.password.second) }}

                    <button type="button" class="btn mallow-medium submit inactive">Modifier le mot de passe</button>
                {{ form_end(editPasswordForm) }}
            </div>
        </div>

        

        <div id="delete-account-popup" class="delete-account-popup popup center" style="display:none">
            
            <h4>Souhaitez-vous réellement supprimer votre compte ?</h4>
            <div class="btns">
                <a href="/delete-account" class="delete-account-btn mallow-medium btn">Confirmer</a>
                <button class="hide-popup-btn btn underline">Annuler</button>
            </div>
            
        </div>

        <div id="delete-project-popup" class="delete-project-popup popup center" style="display:none">

            <h4>Souhaitez-vous réellement supprimer ce projet ?</h4>

            <div class="btns">
                <button class="btn mallow-medium delete-project-btn">Confirmer</button>
                <button class="btn underline hide-popup-btn">Annuler</button>
            </div>
        </div>

        <div class="blur-effect"></div>

        

    </div>



{% endblock %}
