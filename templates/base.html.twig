<!DOCTYPE html>
<html>
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>{% block title %}Welcome!{% endblock %}</title>
        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>⚫️</text><text y=%221.3em%22 x=%220.2em%22 font-size=%2276%22 fill=%22%23fff%22>sf</text></svg>">
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
        
        {% block stylesheets %}
            {{ encore_entry_link_tags('app-style') }}
        {% endblock %}

        {% block javascripts %}
            {{ encore_entry_script_tags('app') }}
            {# {% block importmap %}{{ importmap('app') }}{% endblock %} #}
        {% endblock %}
    </head>
    
    <header>
        {% if app.user %}
            <nav>
                <div class="content">
                    <div class="left-btns">
                        <div id="navbar-projects-btn" class="project-btn">
                            <span>Projets</span>
                            <twig:ux:icon name="bi:chevron-right" />
                        </div>
                        {% if project is defined %}
                            <h1>{{ project.title }}</h1>
                        {% endif %}
                    </div>
                    

                    

                    <a href="/"><img class="logo" src="../logo-taskplan-white.svg" alt="logotaskplan"></a>

                    <div class="right-btns">
                        <a href="/profil"class="initials">{{ app.user.nom|slice(0,1) ~ app.user.prenom|slice(0,1)|upper }}</a>

                        <a href="/logout" class="logout-btn"><twig:ux:icon name="tabler:logout" /></a>
                    </div>
                </div>

                <div class="mallow-shadow"></div>

            </nav>

            <div id="navbar-projects-section" style="display:none">
                <div class="header">
                    <div class="left">
                        <twig:ux:icon name="material-symbols:folder-rounded" />
                        <span>Projets</span>
                    </div>
                    
                    <twig:ux:icon class="hide-section-btn" name="bi:x" />
                </div>

                <div class="content">
                    <div class="projects" style="">
                        {% if app.user.projects is empty %}
                            <p style="opacity:75%" class="empty-projects-message">Aucun projet en cours</p>
                        {% else %}
                            {% for project in app.user.projects %}
                                    <a class="project" href="/project/{{ project.id }}" >{{ project.title }}</a>
                            {% endfor %}
                        {% endif %}
                    </div>
                    <button class="show-add-project-popup-btn btn mallow-white"><twig:ux:icon name="bi:plus-lg" />Ajouter</button>
                </div>
                
            </div>

            <div id="add-project-popup" class="add-project-popup popup center" style="display:none">
                <div class="label-quit">
                    <span>Ajouter un projet</span>
                    <twig:ux:icon class="hide-popup-btn"name="bi:x" />
                </div>

                <input type="text" placeholder="nom du projet">
                <button class="add-project-btn mallow-medium btn inactive">Ajouter</button>
            </div>
        {% endif %}
    </header>

    <body>
        {% block body %}

        {% endblock %}
    </body>
</html>
